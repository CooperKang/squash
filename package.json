{
  "name": "squash",
  "private": true,
  "version": "1.0.0",
  "description": "스쿼시 입문 가이드, 라켓 추천, 대회 현황판, 미니 게임",
  "author": "JaeHa Kang (https://github.com/CooperKang)",
  "license": "MIT",
  "homepage": "https://cooperkang.github.io/squash/",
  "repository": {
    "type": "git",
    "url": "https://github.com/CooperKang/squash.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview",
    "data": "node scripts/fetch-data.mjs",
    "courts": "node scripts/fetch-courts.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  }
}
